<Window x:Class="IptvPlayer.AddPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Añadir lista" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="AddPlaylistWindow">
    <StackPanel Margin="20">
        <TextBlock Text="Añadir lista" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,14" Opacity="0.75" TextWrapping="Wrap"
                   Text="La aplicación no incluye canales: usa la lista M3U o los datos Xtream Codes que te da tu proveedor." />

        <TextBlock Text="Nombre (opcional)" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox" AutomationProperties.Name="Nombre de la lista" />

        <TabControl x:Name="Tabs" Margin="0,14,0,0" AutomationProperties.AutomationId="SourceTabs">
            <TabItem x:Name="M3uTab" Header="Lista M3U" AutomationProperties.AutomationId="M3uTab">
                <StackPanel Margin="4,12,4,4">
                    <TextBlock Text="Dirección (URL) de la lista M3U / M3U8, o un archivo de tu PC" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <DockPanel>
                        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Examinar…" Margin="6,0,0,0"
                                Click="OnBrowse" AutomationProperties.AutomationId="BrowseButton" />
                        <TextBox x:Name="UrlBox" AutomationProperties.AutomationId="UrlBox" AutomationProperties.Name="Dirección de la lista" />
                    </DockPanel>
                    <TextBlock Text="Ejemplo: http://proveedor.com/lista.m3u" Opacity="0.55" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem x:Name="XtreamTab" Header="Xtream Codes" AutomationProperties.AutomationId="XtreamTab">
                <StackPanel Margin="4,12,4,4">
                    <TextBlock Text="Servidor" Margin="0,0,0,4" />
                    <TextBox x:Name="ServerBox" AutomationProperties.AutomationId="ServerBox" AutomationProperties.Name="Servidor" />
                    <TextBlock Text="Ejemplo: http://proveedor.com:8080" Opacity="0.55" FontSize="12" Margin="0,4,0,8" />
                    <TextBlock Text="Usuario" Margin="0,0,0,4" />
                    <TextBox x:Name="UserBox" AutomationProperties.AutomationId="UserBox" AutomationProperties.Name="Usuario" />
                    <TextBlock Text="Contraseña" Margin="0,8,0,4" />
                    <PasswordBox x:Name="PasswordBox" AutomationProperties.AutomationId="PasswordBox" AutomationProperties.Name="Contraseña" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Margin="0,14,0,0" Visibility="Collapsed" />
        <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                   AutomationProperties.AutomationId="DialogError" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancelar" IsCancel="True" MinWidth="100" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CancelButton" />
            <Button x:Name="SaveButton" Content="Guardar y cargar" IsDefault="True" MinWidth="140" Click="OnSave"
                    AutomationProperties.AutomationId="SaveButton" />
        </StackPanel>
    </StackPanel>
</Window>
