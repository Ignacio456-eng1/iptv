<Application x:Class="IptvPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IptvPlayer"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <local:LogoConverter x:Key="LogoConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NotNullToVisible" />
        <local:NullToVisibilityConverter x:Key="NullToVisible" Invert="True" />
        <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Application.Resources>
</Application>
