<Window x:Class="IptvPlayer.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="InputDialog">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" AutomationProperties.AutomationId="ValueBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" Margin="0,0,8,0" AutomationProperties.AutomationId="CancelButton" />
            <Button Content="Aceptar" IsDefault="True" MinWidth="90" Click="OnOk" AutomationProperties.AutomationId="OkButton" />
        </StackPanel>
    </StackPanel>
</Window>
