<Window x:Class="IptvPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="IPTV Player"
        Width="1280" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.AutomationId="MainWindow"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="360" MinWidth="260" />
            <ColumnDefinition x:Name="SplitterColumn" Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral: listas, búsqueda, grupos y canales -->
        <Grid x:Name="Sidebar" Grid.Column="0" Margin="10,10,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button x:Name="AddPlaylistButton" Content="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            ToolTip="Añadir lista" AutomationProperties.Name="Añadir lista"
                            AutomationProperties.AutomationId="AddPlaylistButton" Click="OnAddPlaylist" Padding="9,7" />
                    <Button x:Name="PlaylistMenuButton" Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            ToolTip="Más opciones de la lista" AutomationProperties.Name="Opciones de la lista"
                            AutomationProperties.AutomationId="PlaylistMenuButton" Click="OnPlaylistMenu" Padding="9,7" Margin="4,0,0,0">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="PlaylistMenu">
                                <MenuItem Header="Actualizar lista" x:Name="RefreshMenuItem" AutomationProperties.AutomationId="RefreshMenuItem" Click="OnRefresh" InputGestureText="F5" />
                                <MenuItem Header="Renombrar…" x:Name="RenameMenuItem" AutomationProperties.AutomationId="RenameMenuItem" Click="OnRename" />
                                <MenuItem Header="Borrar lista" x:Name="DeleteMenuItem" AutomationProperties.AutomationId="DeleteMenuItem" Click="OnDelete" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <ComboBox x:Name="PlaylistCombo" ItemsSource="{Binding Playlists}" DisplayMemberPath="Name"
                          AutomationProperties.AutomationId="PlaylistCombo" AutomationProperties.Name="Mis listas"
                          ToolTip="Mis listas" SelectionChanged="OnPlaylistSelected" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Buscar canal" />
                <TextBlock Text="Buscar canal (Ctrl+F)" IsHitTestVisible="False" Opacity="0.55" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NullToVisible}}" />
            </Grid>

            <ComboBox x:Name="GroupCombo" Grid.Row="2" Margin="0,8,0,0" ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="GroupCombo" AutomationProperties.Name="Grupo" ToolTip="Grupo" />

            <ListBox x:Name="ChannelList" Grid.Row="3" Margin="0,8,0,0" ItemsSource="{Binding VisibleChannels}"
                     AutomationProperties.AutomationId="ChannelList" AutomationProperties.Name="Canales"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="OnChannelListKeyDown">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="6,4" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnChannelClicked" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="36" CornerRadius="4" Background="#22FFFFFF">
                                <Image Source="{Binding Logo, Converter={StaticResource LogoConverter}, IsAsync=False}"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="14" />
                                <TextBlock Text="{Binding Group}" TextTrimming="CharacterEllipsis" FontSize="11" Opacity="0.6"
                                           Visibility="{Binding Group, Converter={StaticResource NotNullToVisible}}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding Star}" Click="OnToggleFavorite" FontSize="16"
                                    Padding="6,2" Background="Transparent" BorderThickness="0" Focusable="False"
                                    ToolTip="Favorito" AutomationProperties.AutomationId="FavoriteButton"
                                    AutomationProperties.Name="Favorito" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="4" Margin="0,8,0,0">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6"
                             Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />
                <Border x:Name="ErrorBox" Background="#33E53935" CornerRadius="4" Padding="8,6" Margin="0,0,0,6"
                        Visibility="{Binding Error, Converter={StaticResource NotNullToVisible}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="OnDismissError" Padding="6,2" ToolTip="Cerrar" Background="Transparent" BorderThickness="0" />
                        <TextBlock x:Name="ErrorText" Text="{Binding Error}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="ErrorText" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="CountText" Opacity="0.6" FontSize="12" AutomationProperties.AutomationId="CountText" />
            </StackPanel>
        </Grid>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#22FFFFFF" />

        <!-- Reproductor -->
        <Grid x:Name="PlayerArea" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="Black">
                <vlc:VideoView x:Name="VideoView">
                    <!-- Capa casi transparente sobre el vídeo: recibe el doble clic y muestra mensajes. -->
                    <Grid x:Name="Overlay" Background="#01000000" MouseLeftButtonDown="OnOverlayMouseDown">
                        <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock x:Name="PlaceholderTitle" Text="IPTV Player" FontSize="28" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="PlaceholderText" Margin="0,10,0,0" FontSize="15" Foreground="#CCFFFFFF"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="OsdBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                                Background="#AA000000" CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                            <TextBlock x:Name="OsdText" Foreground="White" FontSize="18" />
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </Border>

            <Border x:Name="ControlBar" Grid.Row="1" Padding="10,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="PrevButton" Content="&#xE892;" ToolTip="Canal anterior (RePág)" Click="OnPrev"
                                AutomationProperties.AutomationId="PrevButton" AutomationProperties.Name="Canal anterior" Style="{StaticResource PlayerButton}" />
                        <Button x:Name="PlayPauseButton" Content="&#xE769;" ToolTip="Pausa / continuar (Espacio)" Click="OnPlayPause"
                                AutomationProperties.AutomationId="PlayPauseButton" AutomationProperties.Name="Pausa" Style="{StaticResource PlayerButton}" />
                        <Button x:Name="StopButton" Content="&#xE71A;" ToolTip="Detener" Click="OnStop"
                                AutomationProperties.AutomationId="StopButton" AutomationProperties.Name="Detener" Style="{StaticResource PlayerButton}" />
                        <Button x:Name="NextButton" Content="&#xE893;" ToolTip="Canal siguiente (AvPág)" Click="OnNext"
                                AutomationProperties.AutomationId="NextButton" AutomationProperties.Name="Canal siguiente" Style="{StaticResource PlayerButton}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="TracksButton" Content="&#xE8D6;" ToolTip="Audio y subtítulos" Click="OnTracks"
                                AutomationProperties.AutomationId="TracksButton" AutomationProperties.Name="Audio y subtítulos" Style="{StaticResource PlayerButton}" />
                        <Button x:Name="MuteButton" Content="&#xE767;" ToolTip="Silenciar (M)" Click="OnMute"
                                AutomationProperties.AutomationId="MuteButton" AutomationProperties.Name="Silenciar" Style="{StaticResource PlayerButton}" />
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="125" Value="100" VerticalAlignment="Center"
                                ValueChanged="OnVolumeChanged" AutomationProperties.AutomationId="VolumeSlider"
                                AutomationProperties.Name="Volumen" ToolTip="Volumen" Margin="4,0" />
                        <Button x:Name="FullscreenButton" Content="&#xE740;" ToolTip="Pantalla completa (F11 o doble clic)" Click="OnFullscreen"
                                AutomationProperties.AutomationId="FullscreenButton" AutomationProperties.Name="Pantalla completa" Style="{StaticResource PlayerButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="12,0">
                        <TextBlock x:Name="NowPlayingText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="NowPlayingText" />
                        <TextBlock x:Name="PlayerStatusText" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="PlayerStatus" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
